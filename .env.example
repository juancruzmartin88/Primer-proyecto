# Credenciales de la cuenta de Exness en MetaTrader 5.
# NUNCA subas el archivo .env real (con datos reales) al repositorio.
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password
# Para arrancar: el servidor de tu cuenta DEMO (lo ves en MT5 al loguearte,
# suele incluir "Trial" o "Demo" en el nombre, ej: Exness-MT5Trial7).
# La traba de seguridad de config.py usa ese nombre para saber si es
# real o demo - copialo EXACTO como lo muestra el terminal.
MT5_SERVER=Exness-MT5Trial7
MT5_PATH=C:\Program Files\MetaTrader 5 Exness\terminal64.exe

# Modo de ejecucion. Mientras DRY_RUN=true, el bot calcula todo pero
# NUNCA envia ordenes reales al broker (solo loguea lo que haria).
DRY_RUN=true

# Fusible de seguridad extra: para que el bot pueda operar en una cuenta
# REAL (no demo), esta variable tiene que tener exactamente este valor.
# Es una traba deliberada para que nadie pase a real por accidente.
LIVE_TRADING_CONFIRMATION=ENTIENDO_EL_RIESGO

# Gestion de riesgo (valores acordados el 14/09/2026 para cuenta real,
# BTC + Oro en simultaneo - ver CLAUDE.md y seccion 3 del sistema)
RISK_PER_TRADE_PCT=2.0
MAX_DAILY_LOSS_PCT=3.0
# OJO: desde el 14/09/2026 este limite es POR INSTRUMENTO, no total de la
# cuenta (el bot opera BTC y Oro en simultaneo). Con MAX_OPEN_POSITIONS=1,
# el maximo simultaneo real es 1 por cada uno (2 en total).
MAX_OPEN_POSITIONS=1

# Limite de tiempo maximo para posiciones abiertas (seccion 6.1 del
# sistema, 17/09/2026). DEJAR EN false: el backtest sobre 7 meses de BTC
# mostro que forzar el cierre (4/8/12/24hs probadas) empeora el profit
# factor entre 18% y 45% frente a no tener ningun limite - corta
# operaciones lentas que igual iban camino al TP. El codigo esta listo en
# src/time_exit.py por si en el futuro se revalida con otras condiciones,
# pero no lo actives sin volver a correr el backtest. Ver CLAUDE.md.
ENABLE_TIME_EXIT=false

# Tercer simbolo (ETH), evaluado el 23/09/2026 con los mismos parametros ya
# validados de BTC (RSI 35/65, vela de rechazo, riesgo 2%, mismo
# StructuralPullbackStrategy sin modificar nada). DEJAR EN false hasta
# confirmar en base a los numeros del backtest - ver CLAUDE.md.
ENABLE_ETH=false
